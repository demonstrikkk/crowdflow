# CrowdFlow Optimiser - backend environment
# Copy to .env (or export) - all values are optional for core functionality.

# Hugging Face API token (https://huggingface.co/settings/tokens)
# Required ONLY for the crowd-sensing (image upload) feature.
HF_API_TOKEN=

# Object-detection model used for people counting
HF_MODEL_ID=facebook/detr-resnet-50

# --------------------------------------------------------------------------- #
# AI provider (natural-language scenario interface). Both are interchangeable:
#   AI_PROVIDER=groq    -> uses GROQ_API_KEY / GROQ_MODEL
#   AI_PROVIDER=gemini  -> uses GEMINI_API_KEY / GEMINI_MODEL
# Secrets are read server-side only and are never exposed to the browser.
# The simulation itself works without any of this.
# --------------------------------------------------------------------------- #
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini Vision architectural reasoning layer (blueprint reconstruction).
# Optional: pipeline falls back to CV + Florence when disabled or unset.
#   BLUEPRINT_GEMINI_ENABLED=true   # opt-in (default off)
#   GEMINI_VISION_MODEL=gemini-3.1-flash-lite
#   GEMINI_VISION_TIMEOUT=75
#   GEMINI_VISION_RETRIES=2
#   GEMINI_VISION_CACHE=1           # cache analysis by image+model+prompt hash
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
BLUEPRINT_GEMINI_ENABLED=false

AI_TIMEOUT=25
AI_MAX_RETRIES=2

# OpenRouteService (optional, external-road routing). Free tier limits apply.
OPENROUTESERVICE_API_KEY=

# Optional: seed value for reproducible simulations
SIM_SEED=42

# --------------------------------------------------------------------------- #
# AI 3D Digital Twin generation (blueprint -> GLB + semantic venue)
# --------------------------------------------------------------------------- #
# Worker that executes the generation. Never a hard dependency: the app and
# existing venues keep working when the worker is offline.
#   TWIN_PROVIDER=auto         -> (DEFAULT) colab when TWIN_COLAB_URL is set,
#                                 otherwise local procedural reconstruction
#   TWIN_PROVIDER=procedural   -> force local deterministic reconstruction
#                                 (works offline, provenance = PROCEDURAL)
#   TWIN_PROVIDER=simulated    -> emulated worker for tests/demo (SIMULATED)
#   TWIN_PROVIDER=colab        -> force real remote GPU inference (provenance = AI)
# For colab you must expose the worker, e.g. via ngrok, and set the public URL:
#   TWIN_COLAB_URL=https://xxxx.ngrok-free.app
# TWIN_COLAB_API_KEY is OPTIONAL. It is only needed if you also set
# WORKER_API_KEY on the Colab side (shared secret, sent as X-API-Key). An ngrok
# free tunnel has no API key of its own; the backend already sends the
# ngrok-skip-browser-warning header that free tunnels require.
#   TWIN_COLAB_API_KEY=
#   TWIN_COLAB_MODEL=hunyuan3d   # Hunyuan3D-2mini (T4-friendly). TRELLIS wheel chain broke in 2026.
#   TWIN_COLAB_POLL_S=2
#   TWIN_COLAB_TIMEOUT_S=60
# Display pacing (seconds between local stage transitions) so progress is
# observable; set 0 for fastest generation.
#   TWIN_STAGE_PACE_S=0.6
